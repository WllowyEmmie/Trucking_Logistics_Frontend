# The browser calls /api/* (and the /api/ws socket) on this origin; Next forwards it to BACKEND_URL.
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:8080
# Optional: connect the position socket somewhere else (e.g. ws://localhost:8080/ws). The API only
# accepts the origins localhost:3000 and localhost:3471.
# NEXT_PUBLIC_WS_URL=

# "enabled" serves the API from MSW handlers in the browser (mocks/), no Go backend needed
NEXT_PUBLIC_API_MOCKING=enabled

# Demo session; replace when real auth exists (out of scope). Plate number or truck uuid.
NEXT_PUBLIC_DEMO_TRUCK_ID=KF-12

# TODO(config): not served by GET /config yet, so set here.
NEXT_PUBLIC_OPERATOR_NAME=Kestrel Freight
NEXT_PUBLIC_SUPPORT_PHONE=+44 113 496 0321
NEXT_PUBLIC_DISPATCH_PHONE=+44 113 496 0300
NEXT_PUBLIC_AGENT_ENABLED=true
# The dispatch agent (POST /ask). A separate service with CORS for localhost:3000/3471, called directly.
NEXT_PUBLIC_AGENT_URL=http://localhost:8200
# Pre-fills the pickup of a new delivery (optional; all three or none).
NEXT_PUBLIC_DEPOT_ADDRESS=Kestrel Freight depot, Unit 4, Hollins Industrial Estate, Wakefield WF2 0XT
NEXT_PUBLIC_DEPOT_LAT=53.6745
NEXT_PUBLIC_DEPOT_LNG=-1.5285
