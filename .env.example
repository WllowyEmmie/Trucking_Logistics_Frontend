# The browser calls /api/* (and the /api/ws socket) on this origin; Next forwards it to BACKEND_URL.
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:8080
# Optional: connect the position socket straight to the API (e.g. wss://your-api.onrender.com/ws).
# Needed on Vercel, which can't forward a socket. The console gets a one-minute pass through /api
# first, since the sign-in cookie doesn't reach another host. The API must list this site's origin
# in CORS_ORIGINS.
# NEXT_PUBLIC_WS_URL=

# "enabled" serves the API from MSW handlers in the browser (mocks/), no Go backend needed
NEXT_PUBLIC_API_MOCKING=enabled

# Sign-in: dispatchers use email + password (accounts made with `go run ./cmd/adduser` in the API);
# drivers use their phone number + a PIN set in Fleet. In mock mode any email/password signs in
# as a dispatcher, and any mock driver's phone with PIN 1234 signs in as that driver.

# Company name, phones, depot, the agent switch and alert thresholds are set on the Settings page
# (stored by the API), not here.
# The dispatch agent. The browser calls /agent/* on this origin and Next forwards it to
# AGENT_BACKEND_URL, so the session cookie goes along (the agent checks a dispatcher is asking).
AGENT_BACKEND_URL=http://localhost:8200
# NEXT_PUBLIC_AGENT_URL=/agent

# Optional. Lists recent tracking links on "/" in a production build (always shown in dev).
# Leave off on a public deployment: the list has every recent customer's name and link.
# NEXT_PUBLIC_SHOW_DEV_INDEX=true
